# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Client Configuration for Vinnes Admin
# Obtenha estas credenciais no Firebase Console > Configurações do Projeto > Seus aplicativos (Web)
VITE_FIREBASE_API_KEY="AIzaSyYourApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="vinnes-admin.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="vinnes-admin"
VITE_FIREBASE_STORAGE_BUCKET="vinnes-admin.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
VITE_FIREBASE_MEASUREMENT_ID="G-ABCDEF1234"
