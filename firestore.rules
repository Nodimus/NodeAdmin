rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Bloqueio padrão para qualquer caminho não explicitado
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Registro Único do Consultório Particular
    // Leitura pública permitida para alimentar a página institucional do consultório
    // Escrita restrita a usuários autenticados da equipe e ESTRITAMENTE limitada ao documento 'dados_gerais' (impede criação de segundo consultório)
    match /consultorio/{documentId} {
      allow read: if true;
      allow write: if request.auth != null && documentId == 'dados_gerais';
    }

    // 2. Coleções Privadas do Consultório
    // Protegidas no servidor: Nenhum dado de paciente, exame, receita, agendamento ou financeiro é acessível sem autenticação válida
    match /patients/{patientId} {
      allow read, write: if request.auth != null;
    }

    match /appointments/{appointmentId} {
      allow read, write: if request.auth != null;
    }

    match /exams/{examId} {
      allow read, write: if request.auth != null;
    }

    match /prescriptions/{prescriptionId} {
      allow read, write: if request.auth != null;
    }

    match /inventory/{itemId} {
      allow read, write: if request.auth != null;
    }

    match /finances/{transactionId} {
      allow read, write: if request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }
  }
}
